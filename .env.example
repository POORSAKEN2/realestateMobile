# Expo Project ID
EXPO_PROJECT_ID=

# API Base URL
# Use VITE_API_BASE_URL for web/vite environments
VITE_API_BASE_URL=http://localhost:8000/api
# Use EXPO_PUBLIC_API_BASE_URL for Expo Go / Native environments
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api

# RevenueCat Test Store public SDK key. Use separate iOS/Android public keys
# for production builds when connecting App Store Connect and Google Play.
EXPO_PUBLIC_REVENUECAT_API_KEY=
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=

# Required for preview and production builds. These must be publicly available
# HTTPS pages; app.config.js rejects release builds when either value is absent.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# New recurring product IDs (no new lifetime products).
EXPO_PUBLIC_REVENUECAT_STARTER_MONTHLY_PRODUCT_ID=starter_monthly
EXPO_PUBLIC_REVENUECAT_STARTER_YEARLY_PRODUCT_ID=starter_yearly
EXPO_PUBLIC_REVENUECAT_PROFESSIONAL_MONTHLY_PRODUCT_ID=professional_monthly
EXPO_PUBLIC_REVENUECAT_PROFESSIONAL_YEARLY_PRODUCT_ID=professional_yearly
EXPO_PUBLIC_REVENUECAT_PORTFOLIO_MONTHLY_PRODUCT_ID=portfolio_monthly
EXPO_PUBLIC_REVENUECAT_PORTFOLIO_YEARLY_PRODUCT_ID=portfolio_yearly

# Legacy identifiers remain for restore and purchase recognition.
# Store product IDs. Defaults shown match constants/revenueCat.ts.
EXPO_PUBLIC_REVENUECAT_TIER1_LIFETIME_PRODUCT_ID=tier1_lifetime
EXPO_PUBLIC_REVENUECAT_TIER1_YEARLY_PRODUCT_ID=tier1_yearly
EXPO_PUBLIC_REVENUECAT_TIER1_MONTHLY_PRODUCT_ID=tier1_monthly
EXPO_PUBLIC_REVENUECAT_ALL_IN_LIFETIME_PRODUCT_ID=all_in_lifetime
EXPO_PUBLIC_REVENUECAT_ALL_IN_YEARLY_PRODUCT_ID=all_in_yearly
EXPO_PUBLIC_REVENUECAT_ALL_IN_MONTHLY_PRODUCT_ID=all_in_monthly

# Optional Google Maps SDK key for future native Android map usage.
GOOGLE_MAPS_API_KEY=
