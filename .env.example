# Expo Project ID
EXPO_PROJECT_ID=

# API Base URL
# Use VITE_API_BASE_URL for web/vite environments
VITE_API_BASE_URL=http://localhost:8000/api
# Use EXPO_PUBLIC_API_BASE_URL for Expo Go / Native environments
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Optional Google Maps SDK key for future native Android map usage.
GOOGLE_MAPS_API_KEY=

# Android MapKit JS token comes from authenticated GET /apple-maps/token.
# Never place Apple private keys or signed MapKit tokens in Expo env vars.

# Optional: replace the public OpenStreetMap Nominatim search service.
EXPO_PUBLIC_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
